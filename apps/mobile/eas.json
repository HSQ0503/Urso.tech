{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://urso.ws"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://urso.ws"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "ws.urso.app",
        "ascAppId": "6797935113"
      }
    }
  }
}
