{
  "expo": {
    "name": "Urso",
    "slug": "urso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "urso",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ws.urso.app",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Urso with Face ID instead of re-entering your PIN.",
        "NSCameraUsageDescription": "Take before and after photos of a job.",
        "NSPhotoLibraryUsageDescription": "Choose a customer photo to send in a text message.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ws.urso.app",
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a customer photo to send in a text message."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#fe5100",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a1cf05e-0b0d-4f25-a1c3-b68601d1a800"
      }
    },
    "owner": "hsq0503"
  }
}
