# Copy to .env.local and fill in. EXPO_PUBLIC_ vars are INLINED INTO THE BUNDLE
# in plain text — only ever put public values here. The Supabase SECRET key,
# Twilio, Square and Resend credentials stay server-side behind /api/v1.

# Where the mobile API lives. Point at a local build to test against a dev box.
EXPO_PUBLIC_API_BASE=https://urso.ws

# Canes Supabase — technician auth only. The publishable (anon) key, never the
# secret key. Find both in the Canes project's API settings.
EXPO_PUBLIC_CANES_SUPABASE_URL=
EXPO_PUBLIC_CANES_SUPABASE_PUBLISHABLE_KEY=

# Woof Gang Supabase — dashboard password authentication. These are the same
# public project values used by the web dashboard; analytics still travel
# through the authenticated Urso API rather than being queried from mobile.
EXPO_PUBLIC_WG_SUPABASE_URL=
EXPO_PUBLIC_WG_SUPABASE_PUBLISHABLE_KEY=
