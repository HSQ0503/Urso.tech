# expo-router depends on vaul/@radix-ui, whose peer ranges demand react-dom.
# This app is iOS-only and never installs react-dom, so a strict peer resolve
# fails on a dependency that is only reachable on the web target. `expo install`
# already overrides these peers; this makes plain `npm install` behave the same
# instead of failing depending on which command you happen to run.
legacy-peer-deps=true
